<%- include('_header', { title: 'Overview' }) %>

<div class="page-heading">
  <div><h1>Device overview</h1><p class="page-description">Manage your tuner and channel lineup.</p></div>
</div>

<div class="admin-overview">
  <section>
    <h2 class="mb-3">Your HDHomeRun</h2>
    <% if (error) { %>
      <div class="alert alert-danger" role="alert">Could not reach device at <strong><%= host %></strong>: <%= error %></div>
      <a href="/admin" class="btn btn-outline-secondary">Try again</a>
    <% } else { %>
      <div class="card"><div class="card-body">
        <dl class="device-details">
          <dt>Friendly name</dt><dd><%= device.FriendlyName %></dd>
          <dt>Model</dt><dd><%= device.ModelNumber %></dd>
          <dt>Firmware</dt><dd><%= device.FirmwareName %> <%= device.FirmwareVersion %></dd>
          <dt>Device ID</dt><dd><%= device.DeviceID %></dd>
          <dt>Tuners</dt><dd><%= device.TunerCount %></dd>
        </dl>
      </div></div>
    <% } %>
  </section>
  <section>
    <h2 class="mb-3">Device tools</h2>
    <div class="admin-tools">
      <a class="admin-tool" href="/admin/channels"><i class="bi bi-list-ul" aria-hidden="true"></i><span><strong>Channel lineup</strong><small>Choose favorites and show or hide channels.</small></span><i class="bi bi-chevron-right" aria-hidden="true"></i></a>
      <a class="admin-tool" href="/admin/scan"><i class="bi bi-broadcast" aria-hidden="true"></i><span><strong>Scan for channels</strong><small>Find channels from your antenna or cable source.</small></span><i class="bi bi-chevron-right" aria-hidden="true"></i></a>
      <a class="admin-tool" href="/admin/status"><i class="bi bi-reception-4" aria-hidden="true"></i><span><strong>Tuner status</strong><small>See active tuners and signal quality.</small></span><i class="bi bi-chevron-right" aria-hidden="true"></i></a>
    </div>
  </section>
</div>

<%- include('_footer') %>
