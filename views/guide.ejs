<%- include('_client_header', { title: 'Live TV' }) %>

<div class="page-heading">
  <div>
    <h1>Live TV</h1>
    <p class="page-description">Browse channels. Watch live.</p>
  </div>
  <nav class="view-switch" aria-label="Guide view">
    <a href="/guide" aria-current="page"><i class="bi bi-list-ul" aria-hidden="true"></i>List</a>
    <a href="/guide/grid"><i class="bi bi-grid-3x3" aria-hidden="true"></i>Grid</a>
  </nav>
</div>

<%- include('_guide_toolbar') %>
<div id="guide-content" hx-get="/guide/fragment" hx-trigger="load" hx-swap="innerHTML" aria-label="Channels">
  <div class="guide-loading" role="status"><span class="spinner-border spinner-border-sm" aria-hidden="true"></span>Loading your channels…</div>
</div>
<div id="guide-filter-empty" class="guide-empty mt-3" hidden>
  <h2>No matching channels</h2>
  <p>Try another search or clear your filters to see all available channels.</p>
  <md-outlined-button id="guide-clear-filters">Clear filters</md-outlined-button>
</div>

<%- include('_watch_overlay') %>
<script src="/js/guide.js?v=<%= assetVersion %>" defer></script>
<%- include('_footer') %>
