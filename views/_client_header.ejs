<%- include('_document_head', { title }) %>
<body class="client-theme<% if (typeof bare !== 'undefined' && bare) { %> client-theme-bare<% } %>">
<% if (typeof bare === 'undefined' || !bare) { %>
  <%- include('_app_nav', { admin: false }) %>
  <main id="main-content" class="app-main<% if (typeof fluid !== 'undefined' && fluid) { %> app-main-wide<% } %>" tabindex="-1">
<% } else { %>
  <main id="main-content" class="p-0">
<% } %>
