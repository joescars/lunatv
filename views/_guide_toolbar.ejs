<div class="guide-toolbar">
  <label class="guide-search" for="guide-search">
    <i class="bi bi-search" aria-hidden="true"></i>
    <span class="visually-hidden">Search channels or programs</span>
    <input id="guide-search" type="search" placeholder="Search channels or programs" autocomplete="off">
  </label>
  <div class="filter-chip-group" role="group" aria-label="Guide filters">
    <input type="checkbox" class="btn-check" id="guide-filter-favorites" autocomplete="off">
    <label class="btn btn-outline-secondary" for="guide-filter-favorites"><i class="bi bi-star" aria-hidden="true"></i>Favorites</label>
    <input type="checkbox" class="btn-check" id="guide-filter-show-hidden" autocomplete="off">
    <label class="btn btn-outline-secondary" for="guide-filter-show-hidden">Show hidden</label>
  </div>
  <span class="guide-count" id="guide-channel-count" role="status" aria-live="polite"></span>
</div>
