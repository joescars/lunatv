<%- include('_client_header', { title: 'Live TV · Grid', fluid: true }) %>

<div class="page-heading">
  <div><h1>Live TV</h1><p class="page-description">Your channels, on a timeline.</p></div>
  <nav class="view-switch" aria-label="Guide view">
    <a href="/guide"><i class="bi bi-list-ul" aria-hidden="true"></i>List</a>
    <a href="/guide/grid" aria-current="page"><i class="bi bi-grid-3x3" aria-hidden="true"></i>Grid</a>
  </nav>
</div>
<%- include('_guide_toolbar') %>

<div id="guide-content" aria-label="Channel schedule">
  <% if (error) { %>
    <div class="guide-empty" role="alert"><h2>Your guide couldn’t load</h2><p><%= error %></p><a href="/guide/grid" class="btn btn-primary">Try again</a><a href="/admin" class="btn btn-outline-secondary">Check device</a></div>
  <% } else if (!channels.length) { %>
    <div class="guide-empty"><h2>No channels available</h2><p>Check your tuner connection or scan for channels.</p><a href="/admin/scan" class="btn btn-primary">Scan channels</a></div>
  <% } else { %>
    <p class="small text-body-secondary">Select a channel or program to watch that channel live. Scroll right for upcoming programs.</p>
    <div class="guide-scroll" tabindex="0" aria-label="Scrollable program schedule"><div class="guide-inner" id="guide-inner"></div></div>
  <% } %>
</div>
<div id="guide-filter-empty" class="guide-empty mt-3" hidden>
  <h2>No matching channels</h2><p>Try another search or clear your filters to see all available channels.</p>
  <md-outlined-button id="guide-clear-filters">Clear filters</md-outlined-button>
</div>

<%- include('_watch_overlay') %>
<script id="guide-data" type="application/json"><%- JSON.stringify({ channels, now }).replace(/</g, '\\u003c') %></script>
<script src="/js/guide-grid.js?v=<%= assetVersion %>" defer></script>
<script src="/js/guide.js?v=<%= assetVersion %>" defer></script>
<%- include('_footer') %>
