  "components": [
    {
      "name": "Primary button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Filled Material action.",
      "html": "<button class=\"ds-primary\">Watch live</button>",
      "css": ".ds-primary{font:500 .9rem Roboto,system-ui,sans-serif;min-height:44px;border-radius:100px;padding:.6rem 1.25rem;cursor:pointer;border:0;background:var(--md-sys-color-primary,#4f378b);color:var(--md-sys-color-on-primary,#fff)}.ds-primary:hover{box-shadow:0 2px 4px rgb(0 0 0 / 15%)}.ds-primary:focus-visible{outline:3px solid var(--md-sys-color-primary,#4f378b);outline-offset:3px;}.ds-primary:active{box-shadow:none}"
    },
    {
      "name": "Secondary button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Outlined secondary action.",
      "html": "<button class=\"ds-secondary\">Try again</button>",
      "css": ".ds-secondary{font:500 .9rem Roboto,system-ui,sans-serif;min-height:44px;border-radius:100px;padding:.6rem 1.25rem;cursor:pointer;border:1px solid var(--md-sys-color-outline,#79747e);background:transparent;color:var(--md-sys-color-on-surface-variant,#49454f)}.ds-secondary:hover{background:var(--md-sys-color-surface-container-high,#e9e7ef)}.ds-secondary:focus-visible{outline:3px solid var(--md-sys-color-primary,#4f378b);outline-offset:3px;}"
    },
    {
      "name": "Filter chip",
      "kind": "chip",
      "refersTo": "chip-selected",
      "description": "Checkbox selection with a visible focus state.",
      "html": "<label class=\"ds-chip\"><input type=\"checkbox\" checked>Favorites</label>",
      "css": ".ds-chip{display:inline-flex;align-items:center;gap:.5rem;min-height:44px;padding:.5rem .85rem;border-radius:8px;font:500 .9rem Roboto,system-ui,sans-serif;background:var(--md-sys-color-secondary-container,#e8def8);color:var(--md-sys-color-on-secondary-container,#1d192b)}.ds-chip:hover{background:var(--md-sys-color-surface-container-high,#e9e7ef)}.ds-chip:focus-within{outline:3px solid var(--md-sys-color-primary,#4f378b);outline-offset:3px;}.ds-chip input{accent-color:var(--md-sys-color-primary,#4f378b)}"
    },
    {
      "name": "Tonal container",
      "kind": "card",
      "refersTo": "card",
      "description": "Quiet supporting content with no decorative shadow.",
      "html": "<section class=\"ds-card\"><h2>Device details</h2><p>Supporting information</p></section>",
      "css": ".ds-card{padding:1.5rem;border-radius:16px;background:var(--md-sys-color-surface-container-low,#f4f1f9);color:var(--md-sys-color-on-surface,#1d1b20);font:1rem/1.5 Roboto,system-ui,sans-serif}.ds-card h2{font-size:1.25rem;font-weight:500;margin:0 0 .5rem}.ds-card p{color:var(--md-sys-color-on-surface-variant,#49454f);margin:0}"
    },
    {
      "name": "Search field",
      "kind": "input",
      "description": "Outlined search field with a container focus ring.",
      "html": "<label class=\"ds-search\"><span>Search</span><input type=\"search\" placeholder=\"Channels or programs\"></label>",
      "css": ".ds-search{display:flex;align-items:center;gap:.75rem;padding:0 1rem;min-height:48px;border-radius:100px;border:1px solid var(--md-sys-color-outline,#79747e);background:var(--md-sys-color-surface-container-low,#f4f1f9);color:var(--md-sys-color-on-surface-variant,#49454f);font:.9rem Roboto,system-ui,sans-serif}.ds-search input{border:0;outline:0;background:transparent;color:var(--md-sys-color-on-surface,#1d1b20);min-width:0;font:inherit;caret-color:var(--md-sys-color-primary,#4f378b)}.ds-search input::placeholder{color:var(--md-sys-color-on-surface-variant,#49454f)}.ds-search:focus-within{outline:3px solid var(--md-sys-color-primary,#4f378b);outline-offset:3px;}"
    },
    {
      "name": "Navigation",
      "kind": "nav",
      "refersTo": "navigation-selected",
      "description": "Tonal current destination with aria-current.",
      "html": "<nav class=\"ds-nav\" aria-label=\"Example navigation\"><a href=\"#live\" aria-current=\"page\">Live TV</a><a href=\"#recordings\">Recordings</a></nav>",
      "css": ".ds-nav{display:flex;gap:.25rem}.ds-nav a{font:500 .9rem Roboto,system-ui,sans-serif;min-height:44px;border-radius:100px;padding:.6rem 1.25rem;cursor:pointer;display:inline-flex;align-items:center;text-decoration:none;color:var(--md-sys-color-on-surface-variant,#49454f)}.ds-nav a[aria-current]{background:var(--md-sys-color-secondary-container,#e8def8);color:var(--md-sys-color-on-secondary-container,#1d192b)}.ds-nav a:hover{background:var(--md-sys-color-surface-container-high,#e9e7ef)}.ds-nav a:focus-visible{outline:3px solid var(--md-sys-color-primary,#4f378b);outline-offset:3px;}"
    },
    {
      "name": "Airing progress",
