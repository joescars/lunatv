        <Label id="favoriteStar" translation="[270, 0]" width="30" height="66" text="*" font="font:LargeBoldSystemFont" horizAlign="center" vertAlign="center" color="0xF5B301FF" visible="false" />
        <Label id="firstLabel" translation="[332, 0]" width="416" height="66" font="font:MediumSystemFont" vertAlign="center" ellipsizeOnBoundary="true" />
        <Label id="secondLabel" translation="[812, 0]" width="416" height="66" font="font:MediumSystemFont" vertAlign="center" ellipsizeOnBoundary="true" />
        <Label id="thirdLabel" translation="[1292, 0]" width="596" height="66" font="font:MediumSystemFont" vertAlign="center" ellipsizeOnBoundary="true" />
