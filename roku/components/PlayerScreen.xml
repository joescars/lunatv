<?xml version="1.0" encoding="utf-8" ?>
<component name="PlayerScreen" extends="Group">
    <interface>
        <!-- in -->
        <field id="serverUrl" type="string" />
        <field id="channelNumber" type="string" />
        <field id="channelName" type="string" />
        <field id="codec" type="string" />
        <field id="streamPath" type="string" />
        <!-- in: ordered list of visible channels for rewind/forward surfing -->
        <field id="channels" type="array" />
        <!-- in: current program details for the playback info overlay -->
        <field id="currentTitle" type="string" />
        <field id="currentSynopsis" type="string" />
        <field id="currentStart" type="integer" />
        <field id="currentDuration" type="integer" />
        <field id="nextTitle" type="string" />
        <field id="channelLogo" type="string" />
        <!-- out: fires when the user backs out of the player -->
        <field id="closed" type="boolean" alwaysNotify="true" />
        <!-- callable from MainScene -->
        <function name="onScreenFocus" />
    </interface>

    <children>
        <Timer id="statsTimer" repeat="true" duration="3" />

        <Video id="video"
            translation="[0, 0]"
            width="1920"
            height="1080"
            visible="false" />

        <Rectangle id="overlayBg"
            translation="[0, 0]"
            width="1920"
            height="1080"
            color="0x06101BFF"
            visible="false" />

        <Group id="loadingCard" visible="false">
            <Rectangle id="loadingGlow" translation="[0, 0]" width="1920" height="1080" color="0x10243A33" />
            <Rectangle translation="[872, 242]" width="176" height="4" color="0x38BDF866" />
            <Rectangle translation="[852, 272]" width="216" height="536" color="0x0B1929E8" />
            <Rectangle translation="[852, 272]" width="216" height="4" color="0x38BDF8FF" />
            <Label translation="[872, 300]" width="176" height="30" text="LUNATV  ·  LIVE" font="font:SmallBoldSystemFont" horizAlign="center" color="0x9CB0C4FF" />
            <Group id="loadingChannelBadge" translation="[908, 368]" width="104" height="104" visible="false">
                <Poster id="loadingChannelLogo" translation="[0, 0]" width="104" height="104" loadDisplayMode="scaleToFit" visible="false" />
                <Rectangle id="loadingChannelBadgeFallback" width="104" height="104" color="0x132A40FF" />
            </Group>
            <Label id="loadingChannelName" translation="[872, 492]" width="176" height="54" horizAlign="center" vertAlign="center" font="font:MediumBoldSystemFont" color="0xFFFFFFFF" ellipsizeOnBoundary="true" />
            <BusySpinner id="spinner" translation="[936, 574]" visible="false" />
            <Label id="loadingSubtitle" translation="[400, 716]" width="1120" height="38" text="Getting live TV ready…" font="font:SmallSystemFont" horizAlign="center" color="0xAFC2D6FF" />
            <Rectangle translation="[892, 782]" width="136" height="2" color="0x38BDF866" />
        </Group>
        <Label id="statusLabel"
            translation="[400, 650]"
            width="1120"
            height="70"
            font="font:LargeBoldSystemFont"
            horizAlign="center"
            vertAlign="center"
            color="0xFFFFFFFF"
            visible="false" />
        <Label id="hintLabel"
            translation="[400, 810]"
            width="1120"
            height="42"
            font="font:SmallSystemFont"
            horizAlign="center"
            vertAlign="center"
            color="0x8FA3B8FF"
            visible="false" />

        <!-- Brief, non-blocking channel/program confirmation after tuning. -->
        <Group id="channelNotice" translation="[460, 870]" visible="false">
            <Rectangle width="1000" height="150" color="0x081321E8" />
            <Rectangle width="5" height="150" color="0x38BDF8FF" />
            <Label id="channelNoticeLabel" translation="[32, 22]" width="930" height="34" font="font:SmallBoldSystemFont" color="0x38BDF8FF" ellipsizeOnBoundary="true" />
            <Label id="channelNoticeDetail" translation="[32, 58]" width="930" height="66" font="font:LargeBoldSystemFont" color="0xFFFFFFFF" ellipsizeOnBoundary="true" />
        </Group>

        <Rectangle id="channelMenuBackdrop" width="1920" height="1080" color="0x00081488" visible="false" />
        <Group id="channelMenuOverlay" translation="[78, 80]" visible="false">
            <Rectangle width="760" height="920" color="0x081321F2" />
            <Rectangle width="760" height="4" color="0x38BDF8FF" />
            <Label translation="[40, 28]" width="680" height="28" text="NOW WATCHING" font="font:SmallBoldSystemFont" color="0x38BDF8FF" />
            <Poster id="menuLogo" translation="[40, 72]" width="116" height="92" loadDisplayMode="scaleToFit" />
            <Label id="menuChannelLabel" translation="[178, 76]" width="520" height="50" font="font:LargeBoldSystemFont" color="0xFFFFFFFF" ellipsizeOnBoundary="true" />
            <Label id="menuChannelMeta" translation="[178, 128]" width="520" height="30" font="font:SmallSystemFont" color="0xBFD2E6FF" />
            <Label id="menuProgramLabel" translation="[40, 198]" width="680" height="70" font="font:LargeBoldSystemFont" color="0xFFFFFFFF" ellipsizeOnBoundary="true" />
            <Label id="menuProgramMeta" translation="[40, 270]" width="680" height="34" font="font:MediumSystemFont" color="0xD7E5F3FF" />
            <Label id="menuNextLabel" translation="[40, 314]" width="680" height="32" font="font:SmallBoldSystemFont" color="0x38BDF8FF" ellipsizeOnBoundary="true" />
            <Label id="menuSynopsisLabel" translation="[40, 356]" width="680" height="94" font="font:SmallSystemFont" wrap="true" color="0xBFD2E6FF" />
            <Rectangle translation="[36, 468]" width="688" height="2" color="0x334155FF" />
            <Group id="menuActionsContent">
                <Rectangle id="menuFavoriteBg" translation="[36, 492]" width="688" height="74" color="0xD9F2FFFF" />
                <Label id="menuFavoriteLabel" translation="[60, 492]" width="640" height="74" font="font:MediumBoldSystemFont" color="0x0A1428FF" vertAlign="center" />
                <Rectangle id="menuRecordBg" translation="[36, 578]" width="688" height="74" color="0x142238FF" />
                <Label id="menuRecordLabel" translation="[60, 578]" width="640" height="74" text="Record current program" font="font:MediumBoldSystemFont" color="0xFFFFFFFF" vertAlign="center" />
                <Rectangle id="menuDetailsBg" translation="[36, 664]" width="688" height="74" color="0x142238FF" />
                <Label id="menuDetailsActionLabel" translation="[60, 664]" width="640" height="74" text="Program details" font="font:MediumBoldSystemFont" color="0xFFFFFFFF" vertAlign="center" />
                <Label translation="[36, 770]" width="688" height="30" text="↑  ↓  Navigate       OK  Select       Back  Resume watching" font="font:SmallSystemFont" horizAlign="center" color="0x9CB0C4FF" />
            </Group>
            <Group id="menuDetailsContent" translation="[36, 488]" visible="false">
                <Rectangle width="688" height="390" color="0x101D33FF" />
                <Label translation="[24, 22]" width="640" height="28" text="PROGRAM DETAILS" font="font:SmallBoldSystemFont" color="0x38BDF8FF" />
                <Label id="menuDetailsTitle" translation="[24, 62]" width="640" height="58" font="font:LargeBoldSystemFont" color="0xFFFFFFFF" ellipsizeOnBoundary="true" />
                <Label id="menuDetailsMeta" translation="[24, 126]" width="640" height="36" font="font:SmallBoldSystemFont" color="0xD7E5F3FF" />
                <Label id="menuDetailsSynopsis" translation="[24, 174]" width="640" height="152" font="font:SmallSystemFont" wrap="true" color="0xBFD2E6FF" />
                <Label translation="[24, 344]" width="640" height="28" text="Press OK or Back to return to channel options" font="font:SmallSystemFont" color="0x9CB0C4FF" />
            </Group>
            <Label id="menuStatusLabel" translation="[36, 838]" width="688" height="38" font="font:SmallBoldSystemFont" horizAlign="center" vertAlign="center" color="0x38BDF8FF" visible="false" />
        </Group>

        <Timer id="infoHideTimer" duration="2.2" repeat="false" />
        <Timer id="menuStatusTimer" duration="2" repeat="false" />

        <Group id="statsPanel" translation="[46, 44]" visible="false">
            <Rectangle
                width="920"
                height="460"
                color="0x0A1428EE" />
            <Rectangle
                width="920"
                height="3"
                color="0x38BDF8FF" />
            <Label id="statsTitle"
                translation="[20, 10]"
                width="880"
                height="34"
                font="font:SmallBoldSystemFont"
                color="0xFFFFFFFF"
                text="Stream diagnostics" />
            <Label id="statsBody"
                translation="[20, 54]"
                width="880"
                height="360"
                font="font:SmallSystemFont"
                wrap="true"
                color="0xD0D0D0FF" />
            <Label id="statsHint"
                translation="[20, 418]"
                width="880"
                height="28"
                font="font:SmallSystemFont"
                color="0x91A4B8FF"
                text="Up: hide diagnostics   Back: return to Guide" />
        </Group>
    </children>

    <script type="text/brightscript" uri="PlayerScreen.brs" />
</component>
